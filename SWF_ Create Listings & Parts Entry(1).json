        "jsCode": "const partId = $input.item.json.Id;\nconst listingFeedId = $input.item.json.ListingFeed_id;\n\nconst sql = `\n  INSERT INTO pobn8zbs31sbv00.\"_nc_m2m_ListingFeed_Parts New\"\n  (\"Parts New_id\", \"ListingFeed_id\")\n  VALUES\n    (${partId}, ${listingFeedId})\n  ON CONFLICT DO NOTHING\n  RETURNING \n    \"Parts New_id\" AS \"PartsLink_id\",\n    \"ListingFeed_id\";\n`;\n\nreturn { sql };"
