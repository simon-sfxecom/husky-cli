      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst values = items.map(item => {\n  const ProductFeed_id = item.json.product_feed_item_id;\n  const PartsNew_id = item.json.Id;\n  return `('${ProductFeed_id}', '${PartsNew_id}')`;\n}).join(',\\n');\n\nconst sql = `\n  INSERT INTO pobn8zbs31sbv00.\"_nc_m2m_Parts New_ProductFeed\" (\"ProductFeed_id\", \"Parts New_id\")\n  VALUES\n  ${values}\n  ON CONFLICT DO NOTHING;\n`;\n\nreturn [{ json: { sql } }];"
