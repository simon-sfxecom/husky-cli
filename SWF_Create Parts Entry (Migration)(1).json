      "parameters": {
        "jsCode": "// n8n Code Node: Convert \"Front, Rear\" → [\"Front\", \"Rear\"]\n\nreturn items.map(item => {\n  const raw = item.json.mountingposition?.[0] || '';\n  const cleaned = raw.split(',').map(x => x.trim());\n\n  return {\n    json: {\n      ...item.json,\n      MountingPosition: cleaned // neue, korrekt formatierte Multi-Select-Variante\n    }\n  };\n});"
      },
