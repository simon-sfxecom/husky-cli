    {
      "parameters": {
        "jsCode": "const items = [];\n\n// Split the comma-separated IDs\nconst ids = ($input.item.json.nocodb_vehicle_variant_id || '').split(',');\n\n// Create separate item for each ID\nids.forEach(id => {\n  items.push({\n    json: {\n      ...$input.item.json,\n      nocodb_vehicle_variant_id: id.trim()\n    }\n  });\n});\n\nreturn items;"
      },
