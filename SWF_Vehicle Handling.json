    {
      "parameters": {
        "jsCode": "// Input: items mit deiner ursprünglichen Struktur\nconst grouped = {};\n\nitems.forEach(item => {\n  const key = `${item.json.type}|${item.json.MountingPositions}|${item.json.part_name}`;\n  \n  if (!grouped[key]) {\n    grouped[key] = {\n      type: item.json.type,\n      MountingPositions: item.json.MountingPositions,\n      nocodb_vehicle_variant_id: [],\n      success: item.json.success,\n      part_name: item.json.part_name\n    };\n  }\n  \n  const variantId = String(item.json.nocodb_vehicle_variant_id);\n  if (!grouped[key].nocodb_vehicle_variant_id.includes(variantId)) {\n    grouped[key].nocodb_vehicle_variant_id.push(variantId);\n  }\n});\n\nreturn Object.values(grouped).map(item => ({ \n  json: {\n    ...item,\n    nocodb_vehicle_variant_id: item.nocodb_vehicle_variant_id.join(',')\n  }\n}));"
      },
