    {
      "parameters": {
        "jsCode": "// n8n Code Node: eBay-Shopify Embedding Matcher (Greedy Bidirectional)\nconst allItems = $input.all().map(i => i.json);\nconst ebayItems = allItems.filter(i => i.ebay_embedding);\nconst shopifyItems = allItems.filter(i => i.shopify_embedding);\n\nconst threshold = 0.85;\nconst reviewThreshold = 0.70;\nconst lockThreshold = 0.90;\n\nfunction cosineSimilarity(vecA, vecB) {\n  if (!vecA?.length || !vecB?.length || vecA.length !== vecB.length) return 0;\n  let dot = 0, normA = 0, normB = 0;\n  for (let i = 0; i < vecA.length; i++) {\n    dot += vecA[i] * vecB[i];\n    normA += vecA[i] * vecA[i];\n    normB += vecB[i] * vecB[i];\n  }\n  const denom = Math.sqrt(normA) * Math.sqrt(normB);\n  return denom === 0 ? 0 : dot / denom;\n}\n\nfunction getStatus(score) {\n  if (score === null) return 'no_match';\n  if (score >= threshold) return 'match';\n  if (score >= reviewThreshold) return 'review';\n  return 'no_match';\n}\n\n// Unique ID Helpers (SeaTable ID statt SKU)\nconst getEbayId = (ebay) => ebay.ebay_shopify_id;\nconst getShopifyId = (shopify) => shopify.seatable_shopify_id;\n\n// Step 1: Alle Paare berechnen\nconst allPairs = [];\nfor (const ebay of ebayItems) {\n  const ebayEmb = ebay?.ebay_embedding?.[0]?.embedding;\n  if (!ebayEmb) continue;\n\n  for (const shopify of shopifyItems) {\n    const shopifyEmb = shopify?.shopify_embedding?.[0]?.embedding;\n    if (!shopifyEmb) continue;\n\n    allPairs.push({ ebay, shopify, score: cosineSimilarity(ebayEmb, shopifyEmb) });\n  }\n}\n\n// Step 2: Nach Score sortieren\nallPairs.sort((a, b) => b.score - a.score);\n\n// Step 3: Greedy Matching (by unique ID)\nconst lockedEbayIds = new Set();\nconst lockedShopifyIds = new Set();\nconst matchedEbayIds = new Set();\nconst matchedShopifyIds = new Set();\nconst matches = [];\n\nfor (const pair of allPairs) {\n  const ebayId = getEbayId(pair.ebay);\n  const shopifyId = getShopifyId(pair.shopify);\n\n  if (lockedEbayIds.has(ebayId) || lockedShopifyIds.has(shopifyId)) continue;\n\n  if (!matchedEbayIds.has(ebayId) && !matchedShopifyIds.has(shopifyId)) {\n    matches.push({ ebay: pair.ebay, shopify: pair.shopify, score: pair.score });\n\n    matchedEbayIds.add(ebayId);\n    matchedShopifyIds.add(shopifyId);\n\n    if (pair.score >= lockThreshold) {\n      lockedEbayIds.add(ebayId);\n      lockedShopifyIds.add(shopifyId);\n    }\n  }\n}\n\n// Step 4: Results\nconst results = [];\n\n// A) Matches\nfor (const match of matches) {\n  const hasValidMatch = match.score >= reviewThreshold;\n  results.push({\n    status: getStatus(match.score),\n    confidence: match.score,\n    ebay_sku: match.ebay.sku,\n    ebay_title: match.ebay.title_de,\n    ebay_seatable_id: getEbayId(match.ebay),\n    shopify_sku: hasValidMatch ? match.shopify.sku : null,\n    shopify_title: hasValidMatch ? match.shopify.shopify_title : null,\n    shopify_seatable_id: hasValidMatch ? getShopifyId(match.shopify) : null\n  });\n}\n\n// B) Ungematchte eBay Items\nfor (const ebay of ebayItems) {\n  if (!matchedEbayIds.has(getEbayId(ebay))) {\n    results.push({\n      status: 'no_match',\n      confidence: null,\n      ebay_sku: ebay.sku,\n      ebay_title: ebay.title_de,\n      ebay_seatable_id: getEbayId(ebay),\n      shopify_sku: null,\n      shopify_title: null,\n      shopify_seatable_id: null\n    });\n  }\n}\n\n// C) Ungematchte Shopify Items\nfor (const shopify of shopifyItems) {\n  if (!matchedShopifyIds.has(getShopifyId(shopify))) {\n    results.push({\n      status: 'no_match',\n      confidence: null,\n      ebay_sku: null,\n      ebay_title: null,\n      ebay_seatable_id: null,\n      shopify_sku: shopify.sku,\n      shopify_title: shopify.shopify_title,\n      shopify_seatable_id: getShopifyId(shopify)\n    });\n  }\n}\n\n// Fallback\nif (!results.length) {\n  return [{\n    json: {\n      status: 'no_match',\n      confidence: null,\n      ebay_sku: null,\n      ebay_title: null,\n      ebay_seatable_id: null,\n      shopify_sku: null,\n      shopify_title: null,\n      shopify_seatable_id: null\n    }\n  }];\n}\n\nreturn results.map(r => ({ json: r }));"
      },
