      "parameters": {
        "jsCode": "const inputItems = items;\n\nlet values = inputItems.map(item => {\n  const url = item.json.Url;\n  const position = item.json.Position;\n  const isSetImage = item.json.IsDefault;\n\n  // Escape einfache Hochkommas\n  const escapedUrl = url.replace(/'/g, \"''\");\n\n  return `('${escapedUrl}', ${position}, ${isSetImage})`;\n}).join(',\\n');\n\nconst sql = `\nINSERT INTO pobn8zbs31sbv00.\"Media\" (\"URL\", \"Position\", \"isSetImage\")\nVALUES\n${values}\nRETURNING id;\n`.trim();\n\nreturn [\n  {\n    json: {\n      query: sql,\n    }\n  }\n];"
      },
